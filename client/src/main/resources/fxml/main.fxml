<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.paint.Color?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/fx"
            fx:controller="com.jobapp.client.controller.MainController"
            style="-fx-background-color: #F5F7FA;">

    <top>
        <VBox style="-fx-background-color: #1976D2; -fx-padding: 12 24 12 24;" vbox="http://javafx.com/javafx/fxml">
            <HBox fx:id="headerBox" alignment="CENTER_LEFT" hbox="http://javafx.com/javafx/fxml" spacing="10">
                <Label fx:id="welcomeLabel" text="Добро пожаловать" 
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane fx:id="notificationBadgeContainer">
                    <Label fx:id="notificationBell" text="&#x2709;" 
                           style="-fx-font-size: 24px; -fx-cursor: hand; -fx-text-fill: white;"
                           onMouseClicked="#handleNotificationClick"/>
                    <Circle fx:id="badgeCircle" radius="8" fill="#FF5722" 
                            centerX="18" centerY="-4" visible="false"/>
                    <Label fx:id="badgeLabel" text="" 
                           style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: white;"
                           translateX="18" translateY="-4" visible="false"/>
                </StackPane>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" 
                 style="-fx-background-color: white;">

            <Tab text="Вакансии">
                <fx:include source="vacancy_list.fxml"/>
            </Tab>

            <Tab text="Мои отклики">
                <fx:include source="applications.fxml"/>
            </Tab>

            <Tab text="Избранное">
                <fx:include source="favorites.fxml"/>
            </Tab>

            <Tab text="История просмотров">
                <fx:include source="view_history.fxml"/>
            </Tab>

            <Tab text="Рекомендации">
                <fx:include source="recommendations.fxml"/>
            </Tab>

            <Tab text="Аналитика">
                <fx:include source="analytics.fxml"/>
            </Tab>

            <Tab text="Уведомления">
                <fx:include source="notifications.fxml"/>
            </Tab>

        </TabPane>
    </center>

</BorderPane>