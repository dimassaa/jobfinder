<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobapp.client.controller.LoginController">
    <VBox alignment="CENTER" maxWidth="400" spacing="12" styleClass="card">
        <padding>
            <Insets bottom="32" left="32" right="32" top="32" />
        </padding>
        
        <Text text="JobMatch" styleClass="h1">
            <VBox.margin>
                <Insets bottom="24" />
            </VBox.margin>
        </Text>

        <VBox spacing="12">
            <Label text="Email" styleClass="label-secondary" />
            <TextField fx:id="emailField" promptText="example@mail.ru" />

            <Label text="Пароль" styleClass="label-secondary" />
            <PasswordField fx:id="passwordField" promptText="Введите пароль" />
        </VBox>

        <Button fx:id="loginButton" onAction="#handleLogin" text="Войти" styleClass="button-primary" maxWidth="Infinity">
            <VBox.margin>
                <Insets top="16" />
            </VBox.margin>
        </Button>

        <HBox alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308">
            <Button fx:id="forgotPasswordButton" onAction="#handleForgotPassword" text="Забыли пароль?" styleClass="button-link" />
        </HBox>

        <Text text="или" styleClass="text-secondary">
            <VBox.margin>
                <Insets top="12" bottom="12" />
            </VBox.margin>
        </Text>

        <Button fx:id="registerButton" onAction="#handleRegister" text="Регистрация" styleClass="button-secondary" maxWidth="Infinity" />
        
        <Label fx:id="statusLabel" styleClass="label-error" text="" visible="false">
            <VBox.margin>
                <Insets top="8" />
            </VBox.margin>
        </Label>

        <HBox alignment="CENTER" spacing="8">
            <HBox.margin>
                <Insets top="8" />
            </HBox.margin>
            <Label fx:id="connectionStatusLabel" styleClass="label-status" text="Статус подключения" />
            <Button fx:id="reconnectButton" onAction="#handleReconnect" text="Переподключиться" styleClass="button-link" />
        </HBox>
    </VBox>
</StackPane>