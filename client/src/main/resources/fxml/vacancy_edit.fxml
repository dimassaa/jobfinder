<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox alignment="TOP_CENTER" spacing="16" styleClass="card" maxWidth="700">
        <padding>
            <Insets bottom="24" left="24" right="24" top="24" />
        </padding>

        <Text text="Вакансия" styleClass="h1">
            <VBox.margin>
                <Insets bottom="16" />
            </VBox.margin>
        </Text>

        <VBox spacing="12" maxWidth="600">
            <VBox spacing="4">
                <Label text="Заголовок вакансии *" styleClass="label-secondary" />
                <TextField fx:id="titleField" promptText="Например: Java Developer" styleClass="text-field" />
            </VBox>

            <VBox spacing="4">
                <Label text="Описание *" styleClass="label-secondary" />
                <TextArea fx:id="descriptionArea" promptText="Опишите обязанности, требования и условия работы..." styleClass="text-field" prefRowCount="6" wrapText="true" />
            </VBox>

            <HBox spacing="16">
                <VBox spacing="4">
                    <Label text="Город *" styleClass="label-secondary" />
                    <TextField fx:id="cityField" promptText="Минск" styleClass="text-field" />
                </VBox>
                <VBox spacing="4">
                    <Label text="Тип занятости *" styleClass="label-secondary" />
                    <ComboBox fx:id="employmentTypeCombo" styleClass="combo-box" />
                </VBox>
            </HBox>

            <HBox spacing="16">
                <VBox spacing="4">
                    <Label text="Зарплата от" styleClass="label-secondary" />
                    <TextField fx:id="salaryMinField" promptText="1000" styleClass="text-field" />
                </VBox>
                <VBox spacing="4">
                    <Label text="Зарплата до" styleClass="label-secondary" />
                    <TextField fx:id="salaryMaxField" promptText="2000" styleClass="text-field" />
                </VBox>
            </HBox>

            <VBox spacing="8">
                <Label text="Навыки (теги)" styleClass="label-secondary" />
                <Text text="Выберите необходимые навыки для вакансии" styleClass="label-status" />
                <ListView fx:id="tagsListView" prefHeight="150" styleClass="list-view"/>
            </VBox>
        </VBox>

        <Label fx:id="statusLabel" styleClass="label-error" text="" visible="false">
            <VBox.margin>
                <Insets top="8" />
            </VBox.margin>
        </Label>

        <HBox alignment="CENTER_RIGHT" spacing="12">
            <HBox.margin>
                <Insets top="16" />
            </HBox.margin>
            <Button fx:id="cancelButton" onAction="#handleCancel" text="Отмена" styleClass="button-secondary" />
            <Button fx:id="saveButton" onAction="#handleSave" text="Сохранить" styleClass="button-primary" />
        </HBox>
    </VBox>
</StackPane>