<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/fx"
            fx:controller="com.jobapp.client.controller.AnalyticsController"
            style="-fx-background-color: #F5F7FA;">

    <top>
        <VBox style="-fx-background-color: #1976D2; -fx-padding: 12 24 12 24;">
            <Label text="Аналитика" 
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="analyticsTabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: white;">

            <Tab text="Зарплаты" fx:id="salariesTab">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <ComboBox fx:id="salaryPeriodCombo" promptText="Выберите период"
                              onAction="#onSalaryPeriodChanged"/>
                    <LineChart fx:id="salaryChart" legendVisible="true">
                        <xAxis>
                            <CategoryAxis label="Период"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Средняя зарплата (руб)"/>
                        </yAxis>
                    </LineChart>
                </VBox>
            </Tab>

            <Tab text="Тренды навыков" fx:id="tagsTab">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <ComboBox fx:id="tagsPeriodCombo" promptText="Выберите период"
                              onAction="#onTagsPeriodChanged"/>
                    <BarChart fx:id="tagsChart">
                        <xAxis>
                            <CategoryAxis label="Навык"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Количество вакансий"/>
                        </yAxis>
                    </BarChart>
                </VBox>
            </Tab>

            <Tab text="География" fx:id="geoTab">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <ComboBox fx:id="geoPeriodCombo" promptText="Выберите период"
                              onAction="#onGeoPeriodChanged"/>
                    <BarChart fx:id="geoChart">
                        <xAxis>
                            <CategoryAxis label="Город"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Количество"/>
                        </yAxis>
                    </BarChart>
                </VBox>
            </Tab>

            <Tab text="Конверсия" fx:id="conversionTab">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Вакансия:"/>
                        <ComboBox fx:id="vacancySelectCombo" promptText="Выберите вакансию" onAction="#onVacancySelected" prefWidth="300"/>
                        <Button text="Обновить" onAction="#onRefreshConversion"/>
                    </HBox>
                    <BarChart fx:id="conversionChart">
                        <xAxis>
                            <CategoryAxis label="Этап"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Количество"/>
                        </yAxis>
                    </BarChart>
                </VBox>
            </Tab>

            <Tab text="Сравнение зарплат" fx:id="salaryCompareTab">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Теги для сравнения:"/>
                        <ComboBox fx:id="tagCompareCombo1" promptText="Тег 1" prefWidth="150"/>
                        <ComboBox fx:id="tagCompareCombo2" promptText="Тег 2" prefWidth="150"/>
                        <Button text="Сравнить" onAction="#onCompareSalaries"/>
                    </HBox>
                    <BarChart fx:id="salaryCompareChart">
                        <xAxis>
                            <CategoryAxis label="Тег"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Средняя зарплата (руб)"/>
                        </yAxis>
                    </BarChart>
                </VBox>
            </Tab>

            <Tab text="Общая статистика" fx:id="systemStatsTab">
                <VBox spacing="15" style="-fx-padding: 15;">
                    <ComboBox fx:id="systemPeriodCombo" promptText="Выберите период"
                              onAction="#onSystemPeriodChanged" prefWidth="150"/>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-min-width: 120;">
                            <Label fx:id="totalUsersLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                            <Label text="Всего пользователей" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                        </VBox>
                        <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-min-width: 120;">
                            <Label fx:id="totalVacanciesLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
                            <Label text="Всего вакансий" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                        </VBox>
                        <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-min-width: 120;">
                            <Label fx:id="totalApplicationsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
                            <Label text="Всего откликов" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                        </VBox>
                        <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-min-width: 120;">
                            <Label fx:id="totalApplicantsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #9C27B0;"/>
                            <Label text="Соискателей" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                        </VBox>
                        <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-min-width: 120;">
                            <Label fx:id="totalHrLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #00BCD4;"/>
                            <Label text="Работодателей" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" VBox.vgrow="ALWAYS">
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label text="Пользователи по ролям" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <PieChart fx:id="usersPieChart" legendVisible="true" minHeight="200"/>
                        </VBox>
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label text="Топ-10 тегов" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <BarChart fx:id="adminTagsChart" minHeight="200">
                                <xAxis>
                                    <CategoryAxis label="Тег"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Количество"/>
                                </yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>

                    <VBox spacing="10" VBox.vgrow="ALWAYS">
                        <Label text="Активность по дням" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <BarChart fx:id="activityChart" minHeight="200">
                            <xAxis>
                                <CategoryAxis label="Дата"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Активность"/>
                            </yAxis>
                        </BarChart>
                    </VBox>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>