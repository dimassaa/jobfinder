<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/fx"
      fx:controller="com.jobapp.client.controller.ApplicationsController"
      spacing="16" styleClass="card">

    <padding>
        <Insets top="16" right="24" bottom="16" left="24"/>
    </padding>

    <Label text="Мои отклики" wrapText="true">
        <font>
            <Font size="20" weight="BOLD"/>
        </font>
    </Label>

    <StackPane VBox.vgrow="ALWAYS">
        <TableView fx:id="applicationsTable" onMouseClicked="#handleTableClick">
            <columns>
                <TableColumn fx:id="titleColumn" text="Вакансия" prefWidth="200"/>
                <TableColumn fx:id="companyColumn" text="Компания" prefWidth="150"/>
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="120"/>
                <TableColumn fx:id="createdAtColumn" text="Дата отклика" prefWidth="150"/>
            </columns>
        </TableView>
    </StackPane>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Изменить статус:" styleClass="label-secondary"/>
        <ComboBox fx:id="statusComboBox" promptText="Выберите статус" styleClass="combo-box"/>
        <Button fx:id="updateStatusButton" text="Обновить" onAction="#handleUpdateStatus" styleClass="button-primary"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="label-secondary" wrapText="true"/>

</VBox>