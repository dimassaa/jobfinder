<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/fx"
      fx:controller="com.jobapp.client.controller.ForgotPasswordController"
      alignment="CENTER" spacing="20" 
      style="-fx-background-color: #F5F7FA; -fx-padding: 40;">

    <Label text="Восстановление пароля" 
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>

    <Label text="Введите ваш email для получения кода восстановления" 
           style="-fx-font-size: 14px; -fx-text-fill: #666;" 
           wrapText="true" maxWidth="300" textAlignment="CENTER"/>

    <GridPane vgap="15" hgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="100" halignment="RIGHT"/>
            <ColumnConstraints minWidth="200"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints/>
        </rowConstraints>

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="0"
               style="-fx-font-size: 14px;"/>
        <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                   promptText="example@mail.by" maxWidth="250"/>
    </GridPane>

    <Label fx:id="statusLabel" text="" style="-fx-font-size: 13px;" wrapText="true" maxWidth="300"/>

    <Button fx:id="sendButton" text="Отправить код" onAction="#handleSendCode"
            style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 30 10 30;"/>

    <Button text="Вернуться к входу" onAction="#handleBackToLogin"
            style="-fx-background-color: transparent; -fx-text-fill: #1976D2; -fx-font-size: 13px;"/>

</VBox>