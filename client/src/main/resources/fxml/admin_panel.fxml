<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/fx"
      fx:controller="com.jobapp.client.controller.AdminPanelController"
      spacing="10" style="-fx-background-color: #F5F7FA; -fx-padding: 15;">

    <Label text="Панель администрирования" 
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>

    <TabPane fx:id="adminTabPane" tabClosingPolicy="UNAVAILABLE">

        <Tab text="Пользователи">
            <VBox spacing="10" style="-fx-padding: 15;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Роль:"/>
                    <ComboBox fx:id="roleFilterCombo" promptText="Все роли" onAction="#handleRoleFilterChanged"/>
                    <Label text="Статус:"/>
                    <ComboBox fx:id="blockFilterCombo" promptText="Все" onAction="#handleBlockFilterChanged"/>
                    <Button text="Обновить" onAction="#handleRefreshUsers" 
                            style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
                </HBox>

                <TableView fx:id="usersTable">
                    <columns>
                        <TableColumn text="ID" prefWidth="50"/>
                        <TableColumn text="Email" prefWidth="150"/>
                        <TableColumn text="Имя" prefWidth="100"/>
                        <TableColumn text="Фамилия" prefWidth="100"/>
                        <TableColumn text="Роль" prefWidth="80"/>
                        <TableColumn text="Город" prefWidth="100"/>
                        <TableColumn text="Заблокирован" prefWidth="100"/>
                        <TableColumn text="Действия" prefWidth="200"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Заблокировать" onAction="#handleBlockUser" 
                            style="-fx-background-color: #FF5722; -fx-text-fill: white;"/>
                    <Button text="Разблокировать" onAction="#handleUnblockUser" 
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                    <Button text="Удалить" onAction="#handleDeleteUser" 
                            style="-fx-background-color: #D32F2F; -fx-text-fill: white;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                    <Label text="Добавить администратора:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="newAdminEmail" promptText="Email" prefWidth="150"/>
                    <TextField fx:id="newAdminPassword" promptText="Пароль" prefWidth="100"/>
                    <TextField fx:id="newAdminName" promptText="Имя" prefWidth="100"/>
                    <Button text="Создать" onAction="#handleCreateAdmin" 
                            style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="Вакансии">
            <VBox spacing="10" style="-fx-padding: 15;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Показывать:"/>
                    <ComboBox fx:id="vacancyFilterCombo" promptText="Активные" onAction="#handleVacancyFilterChanged"/>
                    <Button text="Обновить" onAction="#handleRefreshVacancies" 
                            style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
                </HBox>

                <TableView fx:id="vacanciesTable">
                    <columns>
                        <TableColumn text="ID" prefWidth="50"/>
                        <TableColumn text="Название" prefWidth="200"/>
                        <TableColumn text="Компания" prefWidth="150"/>
                        <TableColumn text="Город" prefWidth="100"/>
                        <TableColumn text="Зарплата" prefWidth="100"/>
                        <TableColumn text="Активна" prefWidth="80"/>
                    </columns>
                </TableView>

                <Button text="Удалить выбранную вакансию" onAction="#handleDeleteVacancy" 
                        style="-fx-background-color: #D32F2F; -fx-text-fill: white;"/>
            </VBox>
        </Tab>

        <Tab text="Жалобы">
            <VBox spacing="10" style="-fx-padding: 15;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Обновить" onAction="#handleRefreshComplaints"
                            style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
                </HBox>

                <TableView fx:id="complaintsTable">
                    <columns>
                        <TableColumn text="ID" prefWidth="50"/>
                        <TableColumn text="Тип" prefWidth="80"/>
                        <TableColumn text="Цель" prefWidth="150"/>
                        <TableColumn text="Причина" prefWidth="200"/>
                        <TableColumn text="Статус" prefWidth="100"/>
                        <TableColumn text="Дата" prefWidth="120"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Отклонить" onAction="#handleDismissComplaint"
                            style="-fx-background-color: #9E9E9E; -fx-text-fill: white;"/>
                    <Button text="Заблокировать вакансию" onAction="#handleBlockVacancyFromComplaint"
                            style="-fx-background-color: #FF5722; -fx-text-fill: white;"/>
                    <Button text="Заблокировать пользователя" onAction="#handleBlockUserFromComplaint"
                            style="-fx-background-color: #D32F2F; -fx-text-fill: white;"/>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="Уведомления">
            <VBox spacing="10" style="-fx-padding: 15;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Обновить" onAction="#handleRefreshNotifications"
                            style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
                    <StackPane>
                        <Label text="&#x2709;" style="-fx-font-size: 20px;"/>
                        <Circle fx:id="adminBadgeCircle" radius="8" fill="#FF5722" centerX="12" centerY="-4" visible="false"/>
                        <Label fx:id="adminBadgeLabel" text="" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: white;" translateX="12" translateY="-4" visible="false"/>
                    </StackPane>
                </HBox>

                <TableView fx:id="adminNotificationsTable">
                    <columns>
                        <TableColumn text="Тип" prefWidth="100"/>
                        <TableColumn text="Заголовок" prefWidth="200"/>
                        <TableColumn text="Содержание" prefWidth="300"/>
                        <TableColumn text="Дата" prefWidth="150"/>
                        <TableColumn text="Статус" prefWidth="80"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Отметить прочитанным" onAction="#handleMarkNotificationRead"
                            style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
                    <Button text="Удалить" onAction="#handleDeleteNotification"
                            style="-fx-background-color: #D32F2F; -fx-text-fill: white;"/>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="Теги">
            <VBox spacing="10" style="-fx-padding: 15;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="newTagField" promptText="Название тега" prefWidth="200"/>
                    <Button text="Добавить тег" onAction="#handleAddTag"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                    <Button text="Обновить" onAction="#handleRefreshTags"
                            style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
                </HBox>

                <TableView fx:id="tagsTable">
                    <columns>
                        <TableColumn text="ID" prefWidth="50"/>
                        <TableColumn text="Название" prefWidth="200"/>
                        <TableColumn text="Активен" prefWidth="100"/>
                    </columns>
                </TableView>

                <Button text="Деактивировать выбранный тег" onAction="#handleDeactivateTag"
                        style="-fx-background-color: #FF5722; -fx-text-fill: white;"/>
            </VBox>
        </Tab>

        <Tab text="Системная аналитика">
            <VBox spacing="15" style="-fx-padding: 15;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="analyticsPeriodCombo" promptText="Выберите период" prefWidth="150"/>
                    <Button text="Загрузить" onAction="#handleLoadAnalytics"
                            style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
                </HBox>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-min-width: 140;">
                        <Label fx:id="adminTotalUsersLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                        <Label text="Всего пользователей" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-min-width: 140;">
                        <Label fx:id="adminTotalVacanciesLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
                        <Label text="Всего вакансий" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-min-width: 140;">
                        <Label fx:id="adminTotalApplicationsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
                        <Label text="Всего откликов" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-min-width: 140;">
                        <Label fx:id="adminTotalApplicantsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #9C27B0;"/>
                        <Label text="Соискателей" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-min-width: 140;">
                        <Label fx:id="adminTotalHrLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #00BCD4;"/>
                        <Label text="Работодателей" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                    </VBox>
                </HBox>

                <HBox spacing="15" VBox.vgrow="ALWAYS">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Пользователи по ролям" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <PieChart fx:id="adminUsersPieChart" legendVisible="true" minHeight="220"/>
                    </VBox>
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Топ-10 тегов" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <BarChart fx:id="adminTagsBarChart" minHeight="220">
                            <xAxis>
                                <CategoryAxis label="Тег"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Количество"/>
                            </yAxis>
                        </BarChart>
                    </VBox>
                </HBox>

                <VBox spacing="10" VBox.vgrow="ALWAYS">
                    <Label text="Активность по дням" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <BarChart fx:id="adminActivityChart" minHeight="220">
                        <xAxis>
                            <CategoryAxis label="Дата"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Активность"/>
                        </yAxis>
                    </BarChart>
                </VBox>
            </VBox>
        </Tab>

    </TabPane>

    <Label fx:id="statusLabel" text="" style="-fx-font-size: 13px;"/>
</VBox>