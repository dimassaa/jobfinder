<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobapp.client.controller.ProfileController">
    <VBox alignment="TOP_CENTER" spacing="16" styleClass="card" maxWidth="600">
        <padding>
            <Insets bottom="24" left="24" right="24" top="24" />
        </padding>

        <Text text="Мой профиль" styleClass="h1">
            <VBox.margin>
                <Insets bottom="16" />
            </VBox.margin>
        </Text>

        <VBox spacing="12" maxWidth="500">
            <HBox spacing="16">
                <VBox spacing="4">
                    <Label text="Имя" styleClass="label-secondary" />
                    <TextField fx:id="nameField" promptText="Иван" styleClass="text-field" />
                </VBox>
                <VBox spacing="4">
                    <Label text="Фамилия" styleClass="label-secondary" />
                    <TextField fx:id="surnameField" promptText="Иванов" styleClass="text-field" />
                </VBox>
            </HBox>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Город" styleClass="label-secondary" />
                    <ComboBox fx:id="cityComboBox" promptText="Выберите город" styleClass="combo-box" />
                </VBox>
                <VBox spacing="4">
                    <Label text="Телефон" styleClass="label-secondary" />
                    <TextField fx:id="phoneField" promptText="+375 (29) 123-45-67" styleClass="text-field" />
                </VBox>
            </HBox>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Навыки" styleClass="label-secondary" />
                    <HBox spacing="8">
                        <Button fx:id="selectTagsButton" text="Выбрать навыки" onAction="#handleSelectTags" styleClass="button-secondary" />
                        <Label fx:id="tagsCountLabel" text="" styleClass="label-secondary" />
                    </HBox>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="О себе" styleClass="label-secondary" />
                <TextArea fx:id="additionalInfoArea" promptText="Расскажите о себе, своих навыках и опыте..." styleClass="text-field" prefRowCount="4" wrapText="true" />
            </VBox>
        </VBox>

        <VBox fx:id="companySection" spacing="12" visible="false" managed="false">
            <VBox.margin>
                <Insets top="16" />
            </VBox.margin>
            <Text text="Информация о компании" styleClass="h2">
                <VBox.margin>
                    <Insets bottom="8" />
                </VBox.margin>
            </Text>

            <VBox spacing="12" maxWidth="500">
                <VBox spacing="4">
                    <Label text="Название компании" styleClass="label-secondary" />
                    <TextField fx:id="companyNameField" promptText="ООО Ромашка" styleClass="text-field" />
                </VBox>

                <VBox spacing="4">
                    <Label text="Веб-сайт" styleClass="label-secondary" />
                    <TextField fx:id="companyWebsiteField" promptText="https://example.com" styleClass="text-field" />
                </VBox>

                <VBox spacing="4">
                    <Label text="Описание компании" styleClass="label-secondary" />
                    <TextArea fx:id="companyDescriptionArea" promptText="Расскажите о вашей компании..." styleClass="text-field" prefRowCount="3" wrapText="true" />
                </VBox>
            </VBox>
        </VBox>

        <Label fx:id="statusLabel" styleClass="label-error" text="" visible="false">
            <VBox.margin>
                <Insets top="8" />
            </VBox.margin>
        </Label>

        <HBox alignment="CENTER_RIGHT" spacing="12">
            <HBox.margin>
                <Insets top="16" />
            </HBox.margin>
            <Button fx:id="cancelButton" onAction="#handleCancel" text="Отмена" styleClass="button-secondary" />
            <Button fx:id="saveButton" onAction="#handleSave" text="Сохранить" styleClass="button-primary" />
        </HBox>
    </VBox>
</StackPane>