<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/fx"
      fx:controller="com.jobapp.client.controller.RegisterController"
      alignment="CENTER" spacing="16" 
      style="-fx-background-color: #F5F7FA; -fx-padding: 40;">

    <Label text="Регистрация" 
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>

    <Label text="Создайте новую учётную запись" 
           style="-fx-font-size: 14px; -fx-text-fill: #666;" 
           wrapText="true" maxWidth="300" textAlignment="CENTER"/>

    <GridPane vgap="12" hgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="100" halignment="RIGHT"/>
            <ColumnConstraints minWidth="200"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
        </rowConstraints>

        <Label text="Имя:" GridPane.columnIndex="0" GridPane.rowIndex="0"
               style="-fx-font-size: 14px;"/>
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                   promptText="Иван" maxWidth="250"/>

        <Label text="Фамилия:" GridPane.columnIndex="0" GridPane.rowIndex="1"
               style="-fx-font-size: 14px;"/>
        <TextField fx:id="surnameField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                   promptText="Иванов" maxWidth="250"/>

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2"
               style="-fx-font-size: 14px;"/>
        <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="2"
                   promptText="example@mail.by" maxWidth="250"/>

        <Label text="Пароль:" GridPane.columnIndex="0" GridPane.rowIndex="3"
               style="-fx-font-size: 14px;"/>
        <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="3"
                       promptText="Минимум 6 символов" maxWidth="250"/>

        <Label text="Роль:" GridPane.columnIndex="0" GridPane.rowIndex="4"
               style="-fx-font-size: 14px;"/>
        <ComboBox fx:id="roleComboBox" GridPane.columnIndex="1" GridPane.rowIndex="4"
                  maxWidth="250"/>
    </GridPane>

    <Label fx:id="statusLabel" text="" style="-fx-font-size: 13px;" wrapText="true" maxWidth="300"/>

    <Button fx:id="registerButton" text="Зарегистрироваться" onAction="#handleRegister"
            style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 30 10 30;"/>

    <Button text="Уже есть аккаунт? Войдите" onAction="#handleBackToLogin"
            style="-fx-background-color: transparent; -fx-text-fill: #1976D2; -fx-font-size: 13px;"/>

</VBox>